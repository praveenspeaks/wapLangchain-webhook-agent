# =============================================================================
# AI Agent — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# --- LLM -------------------------------------------------------------------
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Choose a tool-calling model available to your Groq account.
GROQ_MODEL=openai/gpt-oss-120b

# --- Database (PostgreSQL) --------------------------------------------------
# Used for both LangGraph checkpointer and business data queries
# Set TESTING_DB_URL separately only if tools should use a different DB
POSTGRES_URL=postgres://user:pass@host:5432/dbname

# --- Application ------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- ngrok (local dev only) -------------------------------------------------
NGROK_AUTHTOKEN=your-ngrok-authtoken

# --- Daily WhatsApp greetings -----------------------------------------------
# Apply the migration and set the Shivay credentials before enabling.
GREETINGS_ENABLED=false
GREETINGS_TIME=09:00
# GREETINGS_TIME is evaluated in each recipient's required timezone field.
# Use a long random key for the protected /greetings administration endpoints.
GREETINGS_ADMIN_API_KEY=
SHIVAY_API_URL=
SHIVAY_API_KEY=
SHIVAY_INSTANCE_NAME=

# Incoming message archive, private summary, and owner-only /add workflow
WHATSAPP_ENABLED=false
# Optional independent webhook protection; not the outbound messaging API key.
SHIVAY_WEBHOOK_SECRET=
WHATSAPP_REQUIRE_WEBHOOK_SECRET=false
# Temporary diagnostics: message bodies/phone numbers logged; credential fields redacted.
WEBHOOK_LOG_PAYLOADS=false
# Create missing greeting/WhatsApp tables at startup (additive, safe to repeat).
AUTO_MIGRATE=true
WHATSAPP_OWNER_NUMBER=
WHATSAPP_DATA_ENTRY_ENABLED=false
# Save birthday/anniversary wishes you send, to add later (needs data entry).
WHATSAPP_BIRTHDAY_CAPTURE_ENABLED=false
WHATSAPP_SUMMARIES_ENABLED=false
WHATSAPP_SUMMARY_TIME=21:00
WHATSAPP_SUMMARY_TIMEZONE=Europe/London
WHATSAPP_SUMMARY_MAX_MESSAGES=0
# Delete archived messages older than this many days (hourly); 0 keeps them forever.
WHATSAPP_ARCHIVE_RETENTION_DAYS=2
